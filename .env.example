# Copy this file to .env and fill in values before running the app.
#
# DATABASE_URL — path to the SQLite database file (relative to prisma/)
DATABASE_URL="file:./dev.db"

# Neuravex has no sign-in. It binds 127.0.0.1 so that the only browser which
# can reach it is the one on this machine, which is the whole of the access
# control there is. Everything below is for the case where that is not enough;
# INSTALL.md's "Reaching Neuravex over a network" explains how they fit
# together, and none of them should be set for an ordinary local install.

# HOST — which interfaces to answer on. Anything other than 127.0.0.1 puts an
# unauthenticated builder on the network.
# HOST="127.0.0.1"

# NEURAVEX_ALLOWED_HOSTS — names this server will answer to, besides localhost
# and IP literals. A request for any other Host gets 421.
# NEURAVEX_ALLOWED_HOSTS="neuravex.example.com"

# NEURAVEX_TRUST_PROXY — set to 1 only when something in front of this sets
# X-Forwarded-Host, X-Forwarded-Proto and X-Forwarded-For. Without a proxy,
# those headers are whatever the client typed.
# NEURAVEX_TRUST_PROXY="1"

# PUBLIC_URL — the address visitors use. Used for sitemap.xml, robots.txt and
# social images, which otherwise fall back to localhost.
# PUBLIC_URL="https://neuravex.example.com"

# NEURAVEX_UPLOAD_DIR — where uploaded pictures are kept. Default data/uploads.
# NEURAVEX_UPLOAD_DIR="/var/lib/neuravex/uploads"
