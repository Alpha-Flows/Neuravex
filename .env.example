# Copy this file to .env and fill in values before running the app.
#
# DATABASE_URL — path to the SQLite database file (relative to prisma/)
DATABASE_URL="file:./dev.db"

# AUTH_PASSWORD — the password used to log into the admin panel.
# CHANGE THIS before deploying or sharing your instance!
AUTH_PASSWORD=changeme

# SESSION_SECRET — used to sign session cookies.
# Generate a random string (e.g. `openssl rand -hex 32`) for production.
# If not set, a key is derived from AUTH_PASSWORD (acceptable for local dev only).
# SESSION_SECRET=
