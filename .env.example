# Copy this file to .env and fill in values before running the app.
#
# DATABASE_URL — path to the SQLite database file (relative to prisma/)
DATABASE_URL="file:./dev.db"

# Accounts are created in the app itself: the first visit to the admin
# panel lets you create the first login (email + password), and you can
# invite teammates afterward from Admin -> Account. Everyone with an
# account has full access to every site (no per-site permissions).

# SESSION_SECRET — used to sign session cookies. REQUIRED in production.
# Generate a random string with: openssl rand -hex 32
# If not set, a much weaker key is derived from AUTH_PASSWORD below (or a
# fixed default if that isn't set either) — fine for a quick local trial,
# not for anything reachable by anyone else.
# SESSION_SECRET=

# AUTH_PASSWORD — legacy. Only used as fallback key material for signing
# session cookies when SESSION_SECRET is not set. It is not a login
# password anymore (see accounts, above).
# AUTH_PASSWORD=
