// Prisma schema for the website builder CMS
// SQLite — works fully offline on macOS / Linux / Windows.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Site {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  accent      String   @default("#6366f1")
  /// Up to six more brand colours, as a JSON list of hex slots (see
  /// `normalizePalette` in lib/palette). A block given one stores a reference
  /// to its slot, so changing the slot changes every block that took it.
  palette     String?
  // Visual theme
  fontFamily  String?  // e.g. "Inter, sans-serif"
  headingFont String?  // e.g. "Georgia, serif"
  /// Font files of the site's own, uploaded to the library and each given a
  /// family name, as a JSON list (see `normalizeCustomFonts` in lib/fonts).
  /// The body and heading fonts above name one of these or a bundled font.
  fonts       String?
  /// Heading and body text sizes in px, as JSON (see `normalizeTextStyles`
  /// in lib/text-styles). Empty means the sizes the blocks always had.
  textStyles  String?
  borderRadius String? @default("0.5rem")
  /// How wide the page's content column is, as a CSS length. Empty means the
  /// standard 72rem. It governs the header, the footer, blocks placed straight
  /// on the page, and every section that follows the site.
  contentWidth String?
  // Header style (used by the default header; ignored once headerHtml is set)
  headerBackground String  @default("#ffffff")
  headerOpacity    Int     @default(80)
  headerShape      String  @default("bar")    // "bar" | "rounded" | "pill"
  headerPosition   String  @default("sticky") // "static" | "sticky" | "fixed"
  /// The picture at the start of the default header, as JSON (see
  /// `normalizeLogo` in lib/site-logo).
  logo        String?
  /// The header menu's arrangement — pages, links, labels, dropdowns — as JSON
  /// (see `normalizeMenu` in lib/menu). Empty means every published page.
  menu        String?
  /// A footer laid out from settings, as JSON (see `normalizeFooter` in
  /// lib/footer). Custom footer HTML still wins where there is some.
  footer      String?
  // Editable header / footer (plain text that replaces hardcoded defaults)
  headerHtml  String?
  footerHtml  String?
  // Custom CSS injected on every public page
  customCss   String?
  // SEO defaults (per-page SEO overrides these)
  metaTitle       String?
  metaDescription String?
  ogImage         String?
  /// Where the downloaded site will be put online, as `https://example.com`
  /// or `https://example.com/folder` (see `cleanSiteUrl` in lib/site-address).
  /// A search engine wants a page's canonical address, its sitemap and its
  /// social picture as full addresses, and those are only known once this is.
  siteUrl         String?
  /// What kind of business or person runs the site, as a schema.org type,
  /// for the structured data on the home page (see lib/structured-data).
  /// Empty says nothing, which is the default: the details it is built from
  /// are the legal profile's, and it is the operator's to publish them.
  businessType    String?
  // The tab icon, and the language the site is written in. The language ends
  // up on <html lang>, which is what a screen reader and a translator read.
  favicon         String?
  language        String   @default("en")
  /// The operator's legal details, for the German Impressum (§ 5 DDG, § 18
  /// Abs. 2 MStV) and Datenschutzerklärung (Art. 13 DSGVO), as one JSON
  /// document. It is a single form filled in once, not thirty independent
  /// site settings, and its shape is validated in `lib/legal/profile`.
  legal           String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  pages       Page[]
}

model Page {
  id              String    @id @default(cuid())
  siteId          String
  site            Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  title           String
  slug            String
  content         String    @default("[]")
  published       Boolean   @default(false)
  isHome          Boolean   @default(false)
  /// The page a visitor meets when an address on the site finds nothing,
  /// served with a 404 status and exported as 404.html. One per site, and in
  /// neither the menu nor the sitemap.
  isNotFound      Boolean   @default(false)
  /// A blog post: listed by the posts block and in the site's feed, headed
  /// with its date, author, cover and tags, and kept out of the menu.
  isPost          Boolean   @default(false)
  postDate        DateTime?
  author          String?
  /// A sentence or two for the list of posts and the feed.
  excerpt         String?
  coverImage      String?
  /// Comma-separated.
  tags            String?
  sortOrder       Int       @default(0)
  /// The language the page is written in, as a code like "de", when it is not
  /// the site's own. Empty means the site's language, so changing that
  /// changes every page that never said otherwise.
  language        String?
  /// Pages that are translations of one another carry the same key: the id
  /// of the page the first translation was made from, which means nothing
  /// beyond "these belong together". One page per language in a group.
  translationGroup String?
  /// Set on a page this app generated and still owns: "impressum" or
  /// "datenschutz". It is what lets the footer find them, keeps them out of
  /// the header nav where they would crowd the real pages, and lets the
  /// details be edited once and written back to both.
  legalKind       String?
  // Per-page SEO (inherits from Site if not set)
  metaTitle       String?
  metaDescription String?
  ogImage         String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  revisions   Revision[]
  submissions Submission[]
  redirects   PageRedirect[]

  @@unique([siteId, slug])
  @@index([siteId])
}

/// An address a page used to have, kept so that a link to it still arrives.
/// Renaming a published page moved every link inside the site with it, and
/// none of the ones outside it: a search result, a bookmark, a flyer, another
/// site's link. Each of those became a 404 the moment the page was renamed.
/// The builder forwards the old address to wherever the page is now, and the
/// download leaves a small forwarding page under the old file name.
model PageRedirect {
  id        String   @id @default(cuid())
  siteId    String
  /// The slug the page had.
  fromSlug  String
  /// The page it belongs to, by id, so a second rename needs no second row.
  pageId    String
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([siteId, fromSlug])
  @@index([pageId])
}

/// A block someone kept to use again — a section they built once and want on
/// another page. Saved by hand from the editor; nothing creates these on its own.
model SavedBlock {
  id        String   @id @default(cuid())
  /// What they called it.
  name      String
  /// The block type, for the icon and the label in the palette.
  type      String
  /// The block and everything inside it, as JSON.
  content   String
  /// Kept the same on every page it is placed on: a copy changed on one page
  /// is written into every other copy when that page is saved (see
  /// lib/synced-blocks). A copy carries this row's id as `synced`.
  synced    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// A site or a page somebody saved to start others from, beside the built-in
/// templates. Kept whole, so a template made from a site is every page and
/// setting it had on the day it was saved; later changes to that site do not
/// reach it.
model UserTemplate {
  id        String   @id @default(cuid())
  name      String
  /// "site" or "page".
  kind      String
  /// A site archive (see lib/site-archive) for a site; `{ title, content }`
  /// for a page, as JSON.
  content   String
  /// The address of the site it was saved from, so the links inside it can be
  /// moved to the address of whatever is made from it.
  fromSlug  String   @default("")
  createdAt DateTime @default(now())

  @@index([kind, createdAt])
}

/// A site or page that was deleted, kept whole so it can be put back.
/// Deleting used to be final: a site took its pages, revisions and form
/// submissions with it, behind one browser confirm() and with no undo.
model TrashItem {
  id        String   @id @default(cuid())
  /// "site" or "page"
  kind      String
  /// What it was called, for the trash list.
  label     String
  /// The site it belonged to, so a deleted page can be offered back there.
  siteId    String?
  siteName  String?
  /// The whole thing as JSON: the archive format the export uses.
  payload   String
  deletedAt DateTime @default(now())

  @@index([kind])
  @@index([siteId])
}

model Revision {
  id        String   @id @default(cuid())
  pageId    String
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  title     String
  content   String
  // A save the user asked for (Cmd+S / Save) rather than an autosave.
  // Autosaves within the same window coalesce; manual saves never do.
  manual    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([pageId])
}

model Submission {
  id        String   @id @default(cuid())
  pageId    String
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  data      String   // JSON payload
  createdAt DateTime @default(now())

  @@index([pageId])
}

/// What a person knows about a file they uploaded, which the file itself
/// cannot hold. An upload is stored under a generated name — mu59seflqpe0.png
/// — so the library showed a wall of machine names, and the name the picture
/// arrived with was thrown away at the door. The file on disk stays where it
/// is, and keeps its URL, so renaming cannot break a page that points at it.
model MediaFile {
  id        String   @id @default(cuid())
  /// The public path, e.g. "/uploads/mu59seflqpe0.png".
  url       String   @unique
  /// The name a person reads: the file's own name when it arrived, or one
  /// they typed over it.
  name      String
  /// What the picture shows, for a reader who cannot see it. It travels with
  /// the picture onto the page, the way a bundled photograph's does.
  alt       String   @default("")
  /// The picture's size in pixels, read from the file when it arrived.
  width     Int?
  height    Int?
  /// Set on a smaller copy of another picture, made in the browser as that
  /// one was uploaded: the address of the picture it is a copy of. A page
  /// offers the copies to the browser as `srcset`, so a phone downloads the
  /// 480-pixel copy rather than the 2400-pixel original. Copies are not
  /// listed in the library, and go when their picture goes.
  variantOf String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([variantOf])
}
