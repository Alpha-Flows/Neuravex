  "private": true,
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/run-local.js next dev",
    "setup": "node scripts/first-run.js",
    "build": "node scripts/run-local.js next build",
    "start": "node scripts/start.js",
    "lint": "node scripts/run-local.js next lint",
    "test": "node scripts/run-local.js vitest run",
    "test:watch": "node scripts/run-local.js vitest",
    "test:e2e": "node scripts/run-local.js playwright test",
    "test:all": "npm run test && npm run test:e2e",
    "db:push": "node scripts/run-local.js prisma db push",
    "db:seed": "node scripts/run-local.js tsx prisma/seed.ts",
    "db:reset": "node scripts/db-reset.js",
    "backup": "node scripts/backup.js",
    "desktop": "node electron/server.js",
    "mcp": "node scripts/run-local.js tsx mcp-server.ts",
    "postinstall": "node scripts/run-local.js prisma generate"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@prisma/client": "^5.20.0",
    "autoprefixer": "^10.4.20",
    "clsx": "^2.1.1",
    "lucide-react": "^0.451.0",
    "next": "^14.2.35",
    "postcss": "^8.4.47",
    "prisma": "^5.20.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sanitize-html": "^2.17.7",
    "tailwind-merge": "^2.5.4",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.19.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^20.16.11",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@types/sanitize-html": "^2.16.1",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.15",
    "typescript": "^5.6.3",
    "vitest": "^4.1.10"
  }
